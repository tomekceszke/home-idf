{
  "_doc": "Thermostat view: the room panels' rendering of heatronic/<mac>/thermostat (heatronic-controller docs/DATA.md, Thermostat view). One source for the app page on the heatronic board (phone, desktop) and the wall panel (wall-panel, LVGL). Geometry is given at the base size 328 px; a renderer scales it by its dial size / 328 (the 480x480 panel draws the dial at 328, so 1:1). Colours name a token of design/tokens.json or of colors below.",

  "range": {"min_c": 15, "max_c": 25, "step_c": 0.5},

  "format": {
    "_doc": "One decimal with a point, as the page (toFixed(1)); missing or stale values show the dash. Burner and DHW temperature are whole numbers.",
    "decimals": 1,
    "missing": "–",
    "stale_after_s": 120
  },

  "colors": {
    "heat": "#f08a3c",
    "dhw": "#56c2e6",
    "idle": "#4a6b7b",
    "fault-arc": "#6b3a36",
    "track": "#1e3440",
    "tick": "#3f5e6d",
    "accent": "#f08a3c",
    "on-accent": "#1b1210"
  },

  "dial": {
    "base": 328,
    "center": 164,
    "radius": 146,
    "start_deg": 135,
    "span_deg": 270,
    "track_width": 20,
    "knob_r": 15,
    "knob_stroke": 4,
    "dot_r": 6,
    "ticks": {"every_c": 1, "major_every_c": 5, "inner": 16, "minor_outer": 20, "major_outer": 26, "width": 2},
    "text": {
      "label":     {"dy": -62, "size": 15, "weight": 400, "letter_spacing": 2, "color": "muted"},
      "set":       {"dy": 22, "size": 84, "weight": 600, "letter_spacing": -3, "color": "text"},
      "set_unit":  {"dy": -36, "size": 36, "weight": 600, "color": "text"},
      "now":       {"dy": 62, "size": 19, "weight": 400, "color": "muted"},
      "now_value": {"size": 19, "weight": 600, "color": "text"},
      "source":    {"dy": 86, "size": 13, "weight": 400, "color": "muted", "opacity": 0.8}
    },
    "buttons": {"_doc": "Touch targets: on the 400 px panel dial 72 px across (~11 mm), ~16 px clear of the track ends (mockup v4).", "dx": 52, "dy_factor": 0.78, "r": 29.5, "glyph_size": 36, "stroke": 2.5}
  },

  "states": {
    "_doc": "By the document's state (and flame for heat). arc = colour of the fill and the knob, pill = the shell's pill kind on the page, icon = an entry of icons. The panel's state line is icon + short (in label_color) + detail (muted); {0} = burner %, DHW temperature (whole degrees), fault code or fault text.",
    "heat_flame": {"arc": "heat", "pill": "flow", "icon": "flame", "icon_color": "heat", "label_color": "heat",
                   "headline": {"en": "Heating · burner {0} %", "pl": "Grzanie · palnik {0} %"},
                   "short": {"en": "Heating", "pl": "Ogrzewanie"},
                   "detail": {"en": "· burner {0} %", "pl": "· palnik {0} %"}},
    "heat":       {"arc": "heat", "pill": "heat", "icon": "flame", "icon_color": "muted", "label_color": "heat",
                   "headline": {"en": "Heating · burner paused", "pl": "Grzanie · przerwa palnika"},
                   "short": {"en": "Heating", "pl": "Ogrzewanie"},
                   "detail": {"en": "· burner paused", "pl": "· przerwa palnika"}},
    "dhw":        {"arc": "dhw", "pill": "dhw", "icon": "drop", "icon_color": "dhw", "label_color": "dhw",
                   "headline": {"en": "Charging hot water{0}", "pl": "Grzanie ciepłej wody{0}"},
                   "short": {"en": "Hot water", "pl": "Ciepła woda"},
                   "detail": {"en": "· {0} °C", "pl": "· {0} °C"}},
    "idle":       {"arc": "idle", "pill": "ok", "icon": "pause", "icon_color": "muted", "label_color": "text",
                   "headline": {"en": "Idle", "pl": "Spoczynek"},
                   "short": {"en": "Idle", "pl": "Spoczynek"},
                   "detail": {"en": "", "pl": ""}},
    "fault":      {"arc": "fault-arc", "pill": "bad", "icon": "warning", "icon_color": "bad", "label_color": "bad",
                   "headline": {"en": "Boiler fault {0}", "pl": "Usterka kotła {0}"},
                   "short": {"en": "Fault", "pl": "Usterka"},
                   "detail": {"en": "· {0}", "pl": "· {0}"}},
    "unknown":    {"arc": "idle", "pill": "warn", "icon": "offline", "icon_color": "warn", "label_color": "warn",
                   "headline": {"en": "No data from the boiler", "pl": "Brak danych z kotła"},
                   "short": {"en": "No data", "pl": "Brak danych"},
                   "detail": {"en": "from the boiler", "pl": "z kotła"}}
  },

  "faults": {
    "locking":  {"en": "Boiler locked out", "pl": "Kocioł zablokowany"},
    "blocking": {"en": "Boiler blocking error", "pl": "Błąd blokujący kotła"}
  },

  "modes": {
    "_doc": "icon = on the program button (the level in force; the schedule icon while paused), short = the panel's line next to it.",
    "day":     {"icon": "sun",       "label": {"en": "Day program", "pl": "Program dzienny"},
                "short": {"en": "Day program", "pl": "Program dzienny"}},
    "night":   {"icon": "moon",      "label": {"en": "Night program", "pl": "Program nocny"},
                "short": {"en": "Night program", "pl": "Program nocny"}},
    "frost":   {"icon": "snowflake", "label": {"en": "Frost protection", "pl": "Ochrona przed mrozem"},
                "short": {"en": "Frost protection", "pl": "Ochrona przed mrozem"}},
    "pause":   {"icon": "program",   "label": {"en": "Paused until the next program switch", "pl": "Pauza do następnego przełączenia programu"},
                "short": {"en": "Paused until the switch", "pl": "Pauza do przełączenia"}},
    "unknown": {"icon": "program",   "label": {"en": "Program unknown", "pl": "Program nieznany"},
                "short": {"en": "Program unknown", "pl": "Program nieznany"}}
  },

  "sources": {
    "_doc": "Where the controlling room temperature is measured, by location only (owner, 2026-10-27).",
    "fw100": {"en": "attic", "pl": "poddasze"},
    "w100":  {"en": "living room", "pl": "salon"}
  },

  "texts": {
    "set_point":    {"en": "SET POINT", "pl": "ZADANA"},
    "now":          {"en": "now", "pl": "teraz"},
    "override":     {"en": " · set here or on the W100", "pl": " · ustawione tutaj lub na W100"},
    "override_short": {"en": "Manual until the switch", "pl": "Ręcznie do przełączenia"},
    "outdoor":      {"en": "out", "pl": "zewn."},
    "last_reading": {"en": "Last reading {0} ago", "pl": "Ostatni odczyt {0} temu"},
    "waiting":      {"en": "Waiting for data", "pl": "Czekam na dane"}
  },

  "icons": {
    "_doc": "Material Symbols Rounded, filled (FILL 1, wght 400, GRAD 0, opsz 24): name -> codepoint.",
    "flame":     "ef55",
    "drop":      "e798",
    "pause":     "e034",
    "warning":   "f083",
    "offline":   "e2c1",
    "sun":       "e518",
    "moon":      "f159",
    "snowflake": "eb3b",
    "heat_off":  "f16d",
    "weather":   "f172",
    "program":   "efd6"
  },

  "interaction": {
    "_doc": "Changing the set point (owner, 2026-10-27): − / + in step_c, or turning the ring by its knob or track (a press on the track or within drag_band px of it at the base size, inside and outside; the middle does nothing; owner 2026-10-27: 25 was far wider than the track). The value shown in the accent colour until a document confirms it, or back to the one in force after confirm_timeout_ms (longer than heatronic's 30 s sample period: a panel on MQTT may see the change only with the next document). The program button returns to the program from a pause and from a manual set point (\"auto\" ends both). − / + send send_after_ms after the last press, the ring on release. Requests go to heatronic/room/setpoint/set only while the document says accepts_requests.",
    "step_c": 0.5,
    "drag_band": 7,
    "send_after_ms": 1200,
    "confirm_timeout_ms": 35000,
    "drag_knob_r": 18,
    "drag_halo_r": 28
  },

  "panel": {
    "_doc": "Wall panel 480x480 (mockup v4, owner 2026-10-27). The dial is the base geometry scaled to dial_size (400 / 328), centred, 18 px from the top (owner: not glued to the top edge); dial_text gives its text sizes at that scale. Top bar: clock left, weather icon + outdoor temperature right, both at the clock's size. In the dial the boiler as an icon (flame, drop, warning) midway between the top tick and the label. Bottom: three round buttons (program, pause, hot water) with the mode's short text after the first; a fault or missing data replaces them with one alert line. Sizes in px.",
    "width": 480,
    "height": 480,
    "bg": "#0b161c",
    "dial_size": 400,
    "dial_x": 40,
    "dial_y": 18,
    "dial_text": {"label": 18, "set": 102, "set_unit": 44, "now": 23, "source": 16, "signs": 44, "boiler_icon": 30},
    "top":   {"y": 16, "x": 24, "clock_size": 26, "clock_weight": 600, "icon_dy": 4, "icon_gap": 6, "color": "muted"},
    "modes": {"cy": 436, "r": 30, "stroke": 2, "stroke_on": 3, "program_x": 54, "pause_x": 358, "dhw_x": 428,
              "text_x": 96, "text_size": 20, "icon_size": 30, "disabled_opa": 0.5},
    "alert": {"cy": 436, "size": 22},
    "fonts": [
      {"name": "nunito_16", "weight": 400, "size": 16, "glyphs": "text"},
      {"name": "nunito_18", "weight": 400, "size": 18, "glyphs": "text"},
      {"name": "nunito_23", "weight": 400, "size": 23, "glyphs": "text"},
      {"name": "nunito_44", "weight": 400, "size": 44, "glyphs": "signs"},
      {"name": "nunito_semibold_20", "weight": 600, "size": 20, "glyphs": "text"},
      {"name": "nunito_semibold_22", "weight": 600, "size": 22, "glyphs": "text", "icons": true},
      {"name": "nunito_semibold_23", "weight": 600, "size": 23, "glyphs": "digits"},
      {"name": "nunito_semibold_26", "weight": 600, "size": 26, "glyphs": "digits", "icons": true},
      {"name": "nunito_semibold_44", "weight": 600, "size": 44, "glyphs": "digits"},
      {"name": "nunito_semibold_102", "weight": 600, "size": 102, "glyphs": "digits"},
      {"name": "icons_30", "weight": 400, "size": 30, "glyphs": "none", "icons": true}
    ],
    "glyph_sets": {
      "_doc": "text = printable ASCII, Polish letters and the signs below; digits = what numbers and the clock need; none = icons only.",
      "text": "ASCII ąćęłńóśźżĄĆĘŁŃÓŚŹŻ°·–−",
      "digits": "0123456789.,:–−°% ",
      "signs": "+−",
      "none": ""
    }
  }
}
