{
  "_doc": "Weather view: the wall panel's screen saver, drawn from the retained weather/forecast document (wall-panel docs/DATA.md, Forecast: Open-Meteo through wp-weather on hc-data) and the outdoor temperature of heatronic/<mac>/thermostat. Mockup v1 (owner, 2026-10-29: variant A, the weather icon right of the temperature so the layout is the same for negative values). A touch anywhere opens the thermostat view; the panel comes back here after a minute without a touch.",

  "format": {
    "_doc": "The big temperature: one decimal with a point, as the thermostat; slots in whole degrees. The heatronic reading counts as current while its document is (thermostat format.stale_after_s); without it the forecast's current temperature is shown with by_forecast. A forecast older than stale_after_s is not shown at all.",
    "decimals": 1,
    "missing": "–",
    "stale_after_s": 10800
  },

  "colors": {
    "sun": "#f5c451",
    "rain": "#56c2e6",
    "sep": "#1e3440"
  },

  "conditions": {
    "_doc": "WMO weather_code as Open-Meteo gives it -> icon by day and by night (is_day), its colour, the words under the big temperature. A code not listed is shown as overcast.",
    "clear":     {"codes": [0],                      "day": "sunny",             "night": "clear_night",         "color": "sun",   "label": {"en": "Clear", "pl": "Bezchmurnie"}},
    "mainly":    {"codes": [1],                      "day": "partly_cloudy_day", "night": "partly_cloudy_night", "color": "text",  "label": {"en": "Mainly clear", "pl": "Przeważnie pogodnie"}},
    "partly":    {"codes": [2],                      "day": "partly_cloudy_day", "night": "partly_cloudy_night", "color": "text",  "label": {"en": "Partly cloudy", "pl": "Częściowe zachmurzenie"}},
    "overcast":  {"codes": [3],                      "day": "cloud",             "night": "cloud",               "color": "muted", "label": {"en": "Overcast", "pl": "Pochmurno"}},
    "fog":       {"codes": [45, 48],                 "day": "foggy",             "night": "foggy",               "color": "muted", "label": {"en": "Fog", "pl": "Mgła"}},
    "drizzle":   {"codes": [51, 53, 55],             "day": "rainy_light",       "night": "rainy_light",         "color": "rain",  "label": {"en": "Drizzle", "pl": "Mżawka"}},
    "freezing":  {"codes": [56, 57, 66, 67],         "day": "weather_mix",       "night": "weather_mix",         "color": "rain",  "label": {"en": "Freezing rain", "pl": "Marznący deszcz"}},
    "rain":      {"codes": [61, 63, 80, 81],         "day": "rainy",             "night": "rainy",               "color": "rain",  "label": {"en": "Rain", "pl": "Deszcz"}},
    "heavy":     {"codes": [65, 82],                 "day": "rainy_heavy",       "night": "rainy_heavy",         "color": "rain",  "label": {"en": "Heavy rain", "pl": "Ulewa"}},
    "snow":      {"codes": [71, 73, 75, 77, 85, 86], "day": "weather_snowy",     "night": "weather_snowy",       "color": "text",  "label": {"en": "Snow", "pl": "Śnieg"}},
    "storm":     {"codes": [95, 96, 99],             "day": "thunderstorm",      "night": "thunderstorm",        "color": "warn",  "label": {"en": "Thunderstorm", "pl": "Burza"}}
  },

  "texts": {
    "no_forecast":  {"en": "No forecast", "pl": "Brak prognozy"},
