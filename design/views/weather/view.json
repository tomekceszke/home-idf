                "icon_y": 398, "icon_size": 38, "temp_y": 436, "temp_size": 26, "pop_y": 462, "pop_size": 16,
                "pop_min": 20},
    "no_forecast": {"y": 400, "size": 20, "icon_size": 24, "icon_gap": 8, "icon_dy": 5},
    "fonts": [
